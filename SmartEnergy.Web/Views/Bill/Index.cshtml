@model List<SmartEnergy.Web.Models.BillViewModel>

@{
    ViewData["Title"] = "Faturalarım";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--kepsas-navy);">Faturalarım</h2>
        <p class="text-muted mb-0">KEPSAŞ elektrik faturalarınızı görüntüleyebilir ve online ödeme yapabilirsiniz.</p>
    </div>
    <div class="badge bg-danger fs-6 px-3 py-2">
        <i class="bi bi-exclamation-circle me-1"></i> Toplam Borç: <strong>742,50 ₺</strong>
    </div>
</div>

<div class="portal-card p-0 overflow-hidden mb-4 border">
    <div class="table-responsive">
        <table class="table-custom align-middle">
            <thead>
                <tr>
                    <th>Fatura No</th>
                    <th>Abonelik No</th>
                    <th>Dönem</th>
                    <th>Tüketim (kWh)</th>
                    <th>Tutar (₺)</th>
                    <th>Son Ödeme Tarihi</th>
                    <th>Durum</th>
                    <th class="text-end">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var bill in Model)
                    {
                        <tr>
                            <td><strong>@bill.BillNumber</strong></td>
                            <td><span class="badge bg-light text-dark border">@bill.SubscriptionNumber</span></td>
                            <td>@bill.BillingPeriod</td>
                            <td>@bill.ConsumptionKwh.ToString("N2") kWh</td>
                            <td><strong class="fs-6 text-navy">@bill.TotalAmount.ToString("N2") ₺</strong></td>
                            <td>@bill.DueDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (bill.Status == "Ödendi")
                                {
                                    <span class="badge badge-paid"><i class="bi bi-check-circle me-1"></i> Ödendi</span>
                                }
                                else
                                {
                                    <span class="badge badge-unpaid"><i class="bi bi-clock me-1"></i> Ödenmedi</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (bill.Status != "Ödendi")
                                {
                                    <a asp-controller="Payment" asp-action="Pay" asp-route-billNumber="@bill.BillNumber" asp-route-amount="@bill.TotalAmount" class="btn btn-sm btn-success text-white fw-bold px-3 me-1">
                                        <i class="bi bi-credit-card me-1"></i> Öde
                                    </a>
                                }
                                <a href="#" class="btn btn-sm btn-outline-secondary" title="Fatura İndir"><i class="bi bi-download"></i> PDF</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
