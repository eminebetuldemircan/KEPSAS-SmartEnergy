@{
    ViewData["Title"] = "Fatura Öde";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="portal-card border shadow-sm p-4">
            <h3 class="fw-bold mb-3" style="color: var(--kepsas-navy);"><i class="bi bi-shield-lock-fill text-success me-2"></i> Güvenli Fatura Ödeme</h3>
            <p class="text-muted mb-4">Kart bilgilerinizi girerek faturanızı anında ödeyin.</p>

            <div class="bg-light p-3 rounded mb-4 border d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted d-block" style="font-size: 11px;">FATURA NUMARASI</small>
                    <strong class="fs-5 text-dark">@ViewBag.BillNumber</strong>
                </div>
                <div class="text-end">
                    <small class="text-muted d-block" style="font-size: 11px;">ÖDENECEK TUTAR</small>
                    <strong class="fs-4 text-danger">@ViewBag.Amount.ToString("N2") ₺</strong>
                </div>
            </div>

            <form asp-controller="Payment" asp-action="PayConfirm" method="post">
                <input type="hidden" name="billNumber" value="@ViewBag.BillNumber" />
                <input type="hidden" name="amount" value="@ViewBag.Amount" />

                <div class="form-group mb-3">
                    <label>Kart Sahibinin Adı Soyadı</label>
                    <input type="text" name="cardHolder" class="form-input" placeholder="Betül Demircan" required />
                </div>

                <div class="form-group mb-3">
                    <label>Kart Numarası</label>
                    <input type="text" name="cardNumber" class="form-input" placeholder="4543 **** **** 1234" required />
                </div>

                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <label class="form-label font-size-12 fw-bold text-navy">Son Kullanma Tarihi</label>
                        <input type="text" class="form-input" placeholder="MM/YY" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-size-12 fw-bold text-navy">CVC / CVV</label>
                        <input type="text" class="form-input" placeholder="123" required />
                    </div>
                </div>

                <button type="submit" class="btn-kepsas-navy py-3 w-100 fw-bold">
                    <i class="bi bi-lock-fill me-1"></i> @ViewBag.Amount.ToString("N2") ₺ Ödemeyi Tamamla
                </button>
            </form>
        </div>
    </div>
</div>
