@{
    ViewData["Title"] = "Güvence Bedeli Sorgula";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="portal-card border shadow-sm p-4">
            <h3 class="fw-bold mb-2" style="color: var(--kepsas-navy);"><i class="bi bi-shield-check text-primary me-2"></i> Güvence Bedeli Sorgulama</h3>
            <p class="text-muted mb-4">Aboneliğinize ait kayıtlı güvence bedelini ve iade durumunu sorgulayın.</p>

            <div class="form-group mb-3">
                <label>TCKN / VKN veya Abone No</label>
                <input type="text" class="form-input" value="12345678901" readonly />
            </div>

            <button type="button" onclick="document.getElementById('resultArea').style.display='block'" class="btn-kepsas-navy mb-4">Sorgula <i class="bi bi-search"></i></button>

            <div id="resultArea" style="display:none;" class="bg-light p-4 rounded border">
                <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                    <span class="text-muted">Abonelik No:</span>
                    <strong>SUB-380901</strong>
                </div>
                <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                    <span class="text-muted">Tahsil Edilen Güvence Bedeli:</span>
                    <strong>1.450,00 ₺</strong>
                </div>
                <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                    <span class="text-muted">TÜFE Güncellenmiş Tutar:</span>
                    <strong class="text-success fs-5">1.820,40 ₺</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Durum:</span>
                    <span class="badge badge-paid">Aktif Abonelik</span>
                </div>
            </div>
        </div>
    </div>
</div>
