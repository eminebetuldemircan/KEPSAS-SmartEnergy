@{
    ViewData["Title"] = "Kaçak Kullanım İhbarı";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="portal-card border shadow-sm p-4">
            <h3 class="fw-bold mb-2" style="color: var(--kepsas-navy);"><i class="bi bi-shield-slash text-teal me-2"></i> Kaçak ve Usulsüz Kullanım İhbarı</h3>
            <p class="text-muted mb-4">Elektrik enerjisinin kaçak veya usulsüz kullanımını gizlilik kuralları çerçevesinde bildirin.</p>

            <form asp-controller="QuickAccess" asp-action="SubmitForm" method="post">
                <input type="hidden" name="formType" value="Kaçak İhbar" />
                <input type="hidden" name="title" value="Kaçak Elektrik İhbar Bildirimi" />

                <div class="form-group mb-3">
                    <label>İhbar Edilen Adres / Konum</label>
                    <textarea class="form-input" rows="2" placeholder="İhbar edilen yerin açık adresi veya tarifini giriniz" required></textarea>
                </div>

                <div class="form-group mb-4">
                    <label>Açıklama & Olay Detayları</label>
                    <textarea class="form-input" rows="3" placeholder="Gözlemlenen kaçak kullanım şekli (direkt hat, müdahale vb.)..."></textarea>
                </div>

                <button type="submit" class="btn btn-teal text-white bg-teal py-3 w-100 fw-bold" style="background:#0d9488;">İhbarı Gizli Olarak Gönder <i class="bi bi-shield-lock me-1"></i></button>
            </form>
        </div>
    </div>
</div>
