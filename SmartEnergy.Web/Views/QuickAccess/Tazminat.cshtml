@{
    ViewData["Title"] = "Tazminat Sorgula";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="portal-card border shadow-sm p-4">
            <h3 class="fw-bold mb-2" style="color: var(--kepsas-navy);"><i class="bi bi-award text-warning me-2"></i> Tazminat Sorgulama</h3>
            <p class="text-muted mb-4">Tedarik sürekliliği ve kalite standartları tazminat durumunuzu öğrenin.</p>

            <div class="bg-light p-4 rounded border">
                <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                    <span class="text-muted">Tazminat Kaydı:</span>
                    <strong>TZM-2026-001</strong>
                </div>
                <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                    <span class="text-muted">Tazminat Nedeni:</span>
                    <span>Tedarik Sürekliliği (Kesinti Limit Aşımı)</span>
                </div>
                <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                    <span class="text-muted">Hak Edilen Tutar:</span>
                    <strong class="text-success fs-5">320,00 ₺</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Durum:</span>
                    <span class="badge badge-paid">Onaylandı - Faturadan Düşülecek</span>
                </div>
            </div>
        </div>
    </div>
</div>
