@{
    ViewData["Title"] = "Randevu İşlemleri";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="portal-card border shadow-sm p-4">
            <h3 class="fw-bold mb-2" style="color: var(--kepsas-navy);"><i class="bi bi-calendar-event text-success me-2"></i> Online Randevu İşlemleri</h3>
            <p class="text-muted mb-4">KEPSAŞ Müşteri Hizmetleri Merkezlerimizden sıra beklemeden işlem yapmak için randevunuzu oluşturun.</p>

            <form asp-controller="QuickAccess" asp-action="SubmitForm" method="post">
                <input type="hidden" name="formType" value="Randevu" />
                <input type="hidden" name="title" value="Müşteri Hizmetleri Randevusu" />

                <div class="form-group mb-3">
                    <label>Müşteri Hizmetleri Merkezi Seçin</label>
                    <select class="form-input" required>
                        <option value="Melikgazi">Melikgazi Müşteri Hizmetleri Merkezi</option>
                        <option value="Kocasinan">Kocasinan Müşteri Hizmetleri Merkezi</option>
                        <option value="Talas">Talas Müşteri Hizmetleri Merkezi</option>
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label>İşlem Türü</label>
                    <select class="form-input" required>
                        <option>Abonelik Devir / İptal</option>
                        <option>Sayaç Değişim / Kontrol</option>
                        <option>Fatura ve Tarife Değişikliği</option>
                        <option>Genel Danışmanlık</option>
                    </select>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-size-12 fw-bold text-navy">Randevu Tarihi</label>
                        <input type="date" class="form-input" value="2026-10-10" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-size-12 fw-bold text-navy">Saat Aralığı</label>
                        <select class="form-input" required>
                            <option>10:00 - 10:30</option>
                            <option>11:00 - 11:30</option>
                            <option>14:00 - 14:30</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn-kepsas-navy py-3 w-100 fw-bold">Randevu Oluştur <i class="bi bi-check-circle me-1"></i></button>
            </form>
        </div>
    </div>
</div>
