@{
    ViewData["Title"] = "Alacak İadesi Talebi";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="portal-card border shadow-sm p-4">
            <h3 class="fw-bold mb-2" style="color: var(--kepsas-navy);"><i class="bi bi-cash-stack text-success me-2"></i> Alacak İadesi Talebi</h3>
            <p class="text-muted mb-4">Hesabınızda bulunan fazla/mükerrer ödemelerin iadesini banka hesabınıza talep edin.</p>

            <form asp-controller="QuickAccess" asp-action="SubmitForm" method="post">
                <input type="hidden" name="formType" value="Alacak İadesi" />
                <input type="hidden" name="title" value="Mükerrer Ödeme İadesi" />

                <div class="form-group mb-3">
                    <label>İade Yöntemi</label>
                    <select class="form-input">
                        <option>Banka Hesabına (IBAN)</option>
                        <option>Gelecek Faturadan Mahsup</option>
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label>IBAN Numarası</label>
                    <input type="text" class="form-input" placeholder="TR38 0000 0000 0000 0000 0000 00" value="TR38 0006 2000 0000 1234 5678 90" required />
                </div>

                <div class="form-group mb-4">
                    <label>Açıklama / Fatura No</label>
                    <textarea class="form-input" rows="3" placeholder="Öğrn: FTR-2026-004 numaralı faturam iki kez ödendi..."></textarea>
                </div>

                <button type="submit" class="btn-kepsas-navy py-3 w-100 fw-bold">İade Talebini Gönder <i class="bi bi-arrow-right"></i></button>
            </form>
        </div>
    </div>
</div>
