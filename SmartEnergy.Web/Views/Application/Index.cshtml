@model List<SmartEnergy.Web.Services.PortalApplicationItemModel>
@{
    ViewData["Title"] = "Başvurularım";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--kepsas-navy);">Başvurularım</h2>
        <p class="text-muted mb-0">Veritabanında kayıtlı tüm fesih, iade, tazminat, evrak ve şikayet başvurularınızın canlı takibi.</p>
    </div>
    <a asp-controller="QuickAccess" asp-action="Index" class="btn btn-primary bg-navy border-0">
        <i class="bi bi-plus-circle me-1"></i> Yeni Başvuru Oluştur
    </a>
</div>

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show p-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2 fs-5"></i> <strong>Başarılı!</strong> @ViewBag.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="portal-card p-0 border overflow-hidden">
    <div class="table-responsive">
        <table class="table-custom align-middle">
            <thead>
                <tr>
                    <th>Başvuru No</th>
                    <th>Başvuru Türü</th>
                    <th>Konu / Başlık</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th>Açıklama / Detay</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var app in Model)
                    {
                        var statusBadge = app.Status switch
                        {
                            "Sonuçlandı" or "Onaylandı" => "badge-paid",
                            "Reddedildi" => "badge-unpaid",
                            _ => "badge-pending"
                        };

                        <tr>
                            <td><strong>@app.ApplicationNumber</strong></td>
                            <td><span class="badge bg-light text-navy border">@app.ApplicationType</span></td>
                            <td><strong>@app.Title</strong></td>
                            <td>@app.CreatedAt.ToString("dd.MM.yyyy")</td>
                            <td><span class="badge @statusBadge">@app.Status</span></td>
                            <td><small class="text-secondary">@app.Description</small></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Henüz oluşturulmuş bir başvurunuz bulunmamaktadır.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
